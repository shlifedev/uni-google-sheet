<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      The runtime the generated table code depends on. It has no dependencies.
      The sources live in the Unity package (src/Runtime) and are compiled here unchanged, so Unity and .NET run the same code.
      LangVersion is pinned to 9.0 because that is what Unity 6 and the Unity 7 alpha compile scripts with:
      anything that builds here builds there.
    -->
    <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>HolySheet</RootNamespace>
    <AssemblyName>HolySheet.Runtime</AssemblyName>
    <Description>Runtime for tables generated by HolySheet: manifest, integrity checks, loading and hot reload.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Runtime/**/*.cs" Exclude="../../src/Runtime/Unity/**" LinkBase="Runtime" />
  </ItemGroup>
</Project>
