<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      The command line front end. It parses arguments and prints results; every decision is made by UGS.Core.
      Packed as a .NET tool: `dotnet tool install` gives the `ugs` command.
    -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>UGS.Cli</RootNamespace>
    <AssemblyName>ugs</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ugs</ToolCommandName>
    <PackageId>UGS.Cli</PackageId>
    <Description>UGS command line: build game tables from xlsx, CSV and Google Sheets into C# code and binary data.</Description>
    <RollForward>Major</RollForward>
    <!--
      Server GC: converting tables allocates heavily on every core at once. Measured on 8 tables x 100,000 rows,
      a build takes 0.6 s with it and 2.1 s without, and a small build starts just as fast either way.
    -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../UGS.Core/UGS.Core.csproj" />
    <ProjectReference Include="../UGS.Csv.Sep/UGS.Csv.Sep.csproj" />
    <ProjectReference Include="../UGS.Runtime/UGS.Runtime.csproj" />
  </ItemGroup>
</Project>
