<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Tool-side tasks that sit next to a build rather than inside it: checking a data folder against its manifest,
      creating a signing key, starting a project, describing a run in one line.
      They need the runtime's manifest types as well as the engine, which is why they are not in UGS.Core.
      Used by the desktop host; the CLI keeps its own copies until it is moved over.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>UGS.Tooling</RootNamespace>
    <AssemblyName>UGS.Tooling</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../UGS.Core/UGS.Core.csproj" />
    <ProjectReference Include="../UGS.Runtime/UGS.Runtime.csproj" />
  </ItemGroup>
</Project>
