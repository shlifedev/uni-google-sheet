<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>HolySheet.Desktop.Host</RootNamespace>
    <AssemblyName>holysheet-host</AssemblyName>
    <IsPackable>false</IsPackable>
    <RollForward>Major</RollForward>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../HolySheet.Core/HolySheet.Core.csproj" />
    <ProjectReference Include="../HolySheet.Csv.Sep/HolySheet.Csv.Sep.csproj" />
    <ProjectReference Include="../HolySheet.Runtime/HolySheet.Runtime.csproj" />
    <ProjectReference Include="../HolySheet.Tooling/HolySheet.Tooling.csproj" />
  </ItemGroup>
</Project>
