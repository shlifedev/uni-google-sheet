<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      The engine side of the desktop app. The Tauri shell starts it once and talks to it over stdin/stdout:
      one JSON-RPC 2.0 message per line. It runs the same UGS.Core code as the CLI and the Unity window,
      so all three produce identical output from the same ugs.json.

      Published self-contained as a single file and bundled as a Tauri sidecar (desktop/scripts/build-host.mjs).
      No trimming and no NativeAOT: the engine finds the Sep CSV backend and credential providers by reflection.
    -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>UGS.Desktop.Host</RootNamespace>
    <AssemblyName>ugs-host</AssemblyName>
    <IsPackable>false</IsPackable>
    <RollForward>Major</RollForward>
    <!-- Same as the CLI: converting tables allocates on every core at once. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../UGS.Core/UGS.Core.csproj" />
    <ProjectReference Include="../UGS.Csv.Sep/UGS.Csv.Sep.csproj" />
    <ProjectReference Include="../UGS.Runtime/UGS.Runtime.csproj" />
    <ProjectReference Include="../UGS.Tooling/UGS.Tooling.csproj" />
  </ItemGroup>
</Project>
