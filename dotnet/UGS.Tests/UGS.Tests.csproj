<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- Real cultures are needed to prove that parsing ignores the machine culture. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <RootNamespace>UGS.Tests</RootNamespace>
    <!-- Row classes are private-field types filled by the serializer; reading them through reflection in tests is intended. -->
    <NoWarn>$(NoWarn);xUnit1031</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.9.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.*" />
    <PackageReference Include="MemoryPack" Version="1.22.0" />
    <PackageReference Include="MessagePack" Version="3.1.12" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../UGS.Core/UGS.Core.csproj" />
    <ProjectReference Include="../UGS.Csv.Sep/UGS.Csv.Sep.csproj" />
    <ProjectReference Include="../UGS.Runtime/UGS.Runtime.csproj" />
    <ProjectReference Include="../UGS.Cli/UGS.Cli.csproj" />
    <ProjectReference Include="../UGS.Desktop.Host/UGS.Desktop.Host.csproj" />
    <ProjectReference Include="../samples/Sample.Tables.MemoryPack/Sample.Tables.MemoryPack.csproj" />
    <ProjectReference Include="../samples/Sample.Tables.MessagePack/Sample.Tables.MessagePack.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
