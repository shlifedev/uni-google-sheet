{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window. It talks to the engine only through the rpc command; it has no shell access.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "opener:allow-open-path",
    "opener:allow-open-url",
    "opener:allow-reveal-item-in-dir",
    "dialog:allow-open",
    "dialog:allow-message",
    "dialog:allow-ask",
    "store:default",
    "window-state:default"
  ]
}
