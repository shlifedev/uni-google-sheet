{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HolySheet",
  "version": "2.0.0",
  "identifier": "com.shlifedev.holysheet.desktop",
  "build": {
    "beforeDevCommand": "npm run host && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run host && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HolySheet",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "msi"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Game tables from xlsx, CSV and Google Sheets",
    "copyright": "MIT License",
    "externalBin": [
      "binaries/holysheet-host"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
