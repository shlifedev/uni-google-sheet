/* HolySheet window. Two small palettes follow Unity's own dark and light editor colors, so the window sits next to the Inspector. */

.holysheet {
    flex-grow: 1;
}

.holysheet--dark {
    --holysheet-section: #3e3e3e;
    --holysheet-section-hover: #464646;
    --holysheet-card: rgba(255, 255, 255, 0.025);
    --holysheet-line: #242424;
    --holysheet-dim: #8f8f8f;
    --holysheet-grid-line: rgba(0, 0, 0, 0.3);
}

.holysheet--light {
    --holysheet-section: #d6d6d6;
    --holysheet-section-hover: #cfcfcf;
    --holysheet-card: rgba(255, 255, 255, 0.35);
    --holysheet-line: #999999;
    --holysheet-dim: #5f5f5f;
    --holysheet-grid-line: rgba(0, 0, 0, 0.14);
}

.holysheet-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

.holysheet-icon-button {
    width: 22px;
    height: 18px;
    padding: 1px;
    margin: 1px 0 1px 3px;
    flex-shrink: 0;
}

.holysheet-icon-button > .unity-button__image,
.holysheet-icon-button > Image {
    width: 14px;
    height: 14px;
}

.holysheet-fill {
    flex-grow: 1;
    flex-shrink: 1;
}

.holysheet-tab {
    min-width: 60px;
    -unity-text-align: middle-center;
}

.holysheet-status-icon {
    width: 16px;
    height: 16px;
    align-self: center;
    margin-right: 3px;
}

.holysheet-status {
    -unity-text-align: middle-left;
    margin-right: 8px;
}

.holysheet-build {
    -unity-font-style: bold;
}

.holysheet-banner > .unity-help-box {
    margin: 4px 4px 0 4px;
}

.holysheet-page {
    padding: 6px;
}

.holysheet-empty {
    margin: 10px;
    opacity: 0.6;
    white-space: normal;
}

.holysheet-buttons {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 6px 0 4px 0;
}

.holysheet-buttons > .unity-button {
    margin-left: 3px;
    margin-right: 0;
}

/* Problems */

.holysheet-problem {
    flex-direction: row;
    padding: 3px 6px;
}

.holysheet-problem__icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin: 1px 6px 0 0;
}

.holysheet-problem__message {
    white-space: normal;
}

.holysheet-problem__detail {
    flex-direction: row;
    flex-wrap: wrap;
    font-size: 11px;
}

.holysheet-problem__location {
    margin-right: 8px;
}

.holysheet-problem__hint {
    flex-shrink: 1;
    white-space: normal;
    opacity: 0.6;
}

/* Problems panel under the table view, and the bar that opens it */

.holysheet-problems {
    border-top-width: 1px;
    border-top-color: var(--holysheet-line);
}

.holysheet-problems-bar {
    border-top-width: 1px;
    border-top-color: var(--holysheet-line);
}

.holysheet-problems-bar__arrow {
    -unity-text-align: middle-center;
    font-size: 8px;
    width: 14px;
    margin: 0 0 0 2px;
    color: var(--holysheet-dim);
}

.holysheet-problems-bar__count {
    flex-direction: row;
    align-items: center;
    margin: 0 4px 0 2px;
}

.holysheet-problems-bar__count > .holysheet-icon {
    margin-right: 2px;
}

.holysheet-problems-bar__count > .unity-label {
    margin: 0;
    padding: 0;
}

.holysheet-problems-bar__text {
    -unity-text-align: middle-left;
    margin: 0 4px;
    color: var(--holysheet-dim);
}

.holysheet-status {
    cursor: link;
}

/* Tables */

.holysheet-side {
    flex-grow: 1;
    min-width: 120px;
}

.holysheet-search {
    flex-grow: 1;
    flex-shrink: 1;
    width: auto;
    min-width: 60px;
    margin-right: 4px;
}

.holysheet-search__count {
    flex-shrink: 0;
    -unity-text-align: middle-left;
    margin: 0 6px 0 0;
    font-size: 11px;
    color: var(--holysheet-dim);
}

.holysheet-tree-row {
    flex-direction: row;
    align-items: center;
    height: 20px;
}

.holysheet-tree-row > .holysheet-icon {
    margin-right: 4px;
}

.holysheet-tree-row__name {
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 0;
    margin: 0;
}

.holysheet-tree-row__note {
    margin: 0 0 0 4px;
    padding: 0;
    font-size: 10px;
    color: var(--holysheet-dim);
}

/* Under the tree: what is selected, and Check / Build for just that. */
.holysheet-selection {
    border-top-width: 1px;
    border-top-color: var(--holysheet-line);
}

.holysheet-selection__label {
    flex-grow: 1;
    flex-shrink: 1;
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin: 0 4px;
    color: var(--holysheet-dim);
}

.holysheet-caption {
    flex-direction: row;
    padding: 3px 6px;
    font-size: 11px;
    color: var(--holysheet-dim);
    border-bottom-width: 1px;
    border-bottom-color: var(--holysheet-line);
}

.holysheet-caption > .unity-label {
    margin: 0;
    padding: 0;
}

/* "View": a small dropdown button, so it reads as something to press. */
.holysheet-caption__menu {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    height: 18px;
    margin: -2px 8px -2px 8px;
    padding: 0 4px 0 8px;
    border-radius: 3px;
}

.holysheet-caption > .holysheet-caption__menu > .holysheet-caption__menu-label {
    margin: 0;
    padding: 0;
    font-size: 11px;
    color: var(--unity-colors-button-text);
}

.holysheet-caption__menu-arrow {
    margin: 0 0 0 6px;
}

.holysheet-caption__hint {
    flex-shrink: 0;
    margin-left: 8px;
    opacity: 0.8;
}

.holysheet-find__key,
.holysheet-find__all {
    min-width: 34px;
    -unity-text-align: middle-center;
}

.holysheet-find__field {
    flex-grow: 1;
    flex-shrink: 1;
    width: auto;
    min-width: 80px;
}

.holysheet-find__count {
    -unity-text-align: middle-left;
    margin: 0 6px;
    color: var(--holysheet-dim);
}

/* Header and cells share one left edge: 4px of padding, no label margin. */

.holysheet-header {
    padding: 2px 4px;
    overflow: hidden;
}

.holysheet-header > .unity-label,
.holysheet-cell {
    margin: 0;
    padding: 0 4px 0 0;
}

.holysheet-header > .unity-label {
    -unity-font-style: bold;
}

.holysheet-header > .holysheet-header__type {
    -unity-font-style: normal;
    font-size: 10px;
    color: var(--holysheet-dim);
}

.holysheet-cell {
    flex-grow: 1;
    padding-left: 4px;
    -unity-text-align: middle-left;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.holysheet-cell--number {
    -unity-text-align: middle-right;
    padding-right: 6px;
}

/*
 * Type colors, as in a code editor: the type under each heading in full, the values softer.
 * Integers and decimals differ; float and double share one color; text keeps the default.
 */

.holysheet--dark .holysheet-type--int { color: #8db7e6; }
.holysheet--dark .holysheet-type--float { color: #7fc8b0; }
.holysheet--dark .holysheet-type--bool { color: #e3a46a; }
.holysheet--dark .holysheet-type--date { color: #c3a1e0; }
.holysheet--dark .holysheet-type--enum { color: #d8c578; }
.holysheet--dark .holysheet-type--ref { color: #e597b6; }

.holysheet--light .holysheet-type--int { color: #2c5d9b; }
.holysheet--light .holysheet-type--float { color: #1d7660; }
.holysheet--light .holysheet-type--bool { color: #a0560f; }
.holysheet--light .holysheet-type--date { color: #7243a0; }
.holysheet--light .holysheet-type--enum { color: #85700f; }
.holysheet--light .holysheet-type--ref { color: #a13a66; }

.holysheet-type--mapping {
    -unity-font-style: italic;
}

/* Type colors apply to the type under each heading only; cells carry no type class and keep the default text color. */

.holysheet-cell--row {
    -unity-text-align: middle-right;
    opacity: 0.5;
}

/*
 * View style, chosen per user from "View" above the table: lines between rows and columns, and where text sits.
 * The row number stays on the right whatever the alignment.
 */

.holysheet-grid--rows .unity-multi-column-view__row-container {
    border-bottom-width: 1px;
    border-bottom-color: var(--holysheet-grid-line);
}

.holysheet-grid--columns .unity-multi-column-view__cell {
    border-right-width: 1px;
    border-right-color: var(--holysheet-grid-line);
}

.holysheet-grid--left .holysheet-cell { -unity-text-align: middle-left; }
.holysheet-grid--center .holysheet-cell { -unity-text-align: middle-center; }
.holysheet-grid--right .holysheet-cell { -unity-text-align: middle-right; }
.holysheet-grid--center .holysheet-header > .unity-label { -unity-text-align: upper-center; }
.holysheet-grid--right .holysheet-header > .unity-label { -unity-text-align: upper-right; }
.holysheet-grid .holysheet-cell--row { -unity-text-align: middle-right; }

/* Settings */

.holysheet-form {
    padding-bottom: 8px;
}

/* Section header: a full-width bar with an icon, like an Inspector component header. */

.holysheet-section {
    margin: 0;
}

.holysheet-section > .unity-foldout__toggle {
    margin: 0;
    padding: 0 4px;
    height: 22px;
    background-color: var(--holysheet-section);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: var(--holysheet-line);
    -unity-font-style: bold;
}

.holysheet-section > .unity-foldout__toggle:hover {
    background-color: var(--holysheet-section-hover);
}

.holysheet-section > .unity-foldout__toggle > .unity-foldout__input {
    align-items: center;
}

.holysheet-section__icon {
    margin: 0 4px 0 2px;
    align-self: center;
}

/* The header bar spans the window; the fields under it stop at a readable width. */
.holysheet-section > .unity-foldout__content {
    margin-left: 0;
    padding: 4px 6px 8px 6px;
    max-width: 680px;
}

.holysheet-subheading {
    margin: 6px 3px 2px 3px;
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--holysheet-dim);
}

.holysheet-subheading:first-child {
    margin-top: 0;
}

/* A source is a card: icon, kind, a short summary of where it reads from, and a remove button. */

.holysheet-card {
    background-color: var(--holysheet-card);
    border-width: 1px;
    border-color: var(--holysheet-line);
    border-radius: 3px;
    padding: 3px 4px 4px 4px;
    margin: 0 0 6px 0;
}

.holysheet-card__head {
    flex-direction: row;
    align-items: center;
    min-height: 20px;
    margin-bottom: 2px;
}

.holysheet-card__head > .holysheet-icon {
    margin: 0 4px 0 3px;
}

.holysheet-card__title {
    -unity-font-style: bold;
    margin: 0 8px 0 0;
    padding: 0;
}

.holysheet-card__summary {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--holysheet-dim);
    margin: 0;
    padding: 0;
}

.holysheet-add {
    align-self: flex-start;
    margin: 0 0 0 0;
    padding: 1px 8px 1px 4px;
}

.holysheet-add > .unity-button__image,
.holysheet-add > Image {
    width: 14px;
    height: 14px;
    margin-right: 3px;
}

.holysheet-path {
    flex-direction: row;
    align-items: center;
}

.holysheet-path > .unity-base-field {
    flex-grow: 1;
    flex-shrink: 1;
}

.holysheet-report {
    white-space: normal;
    margin: 4px 3px 0 3px;
}

.holysheet-footer {
    justify-content: flex-end;
    max-width: 680px;
    margin: 8px 6px 0 6px;
}
